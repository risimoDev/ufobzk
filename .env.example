# ═══════════════════════════════════════════
#  VPNBZK — Каскадный VPN (Production)
# ═══════════════════════════════════════════

# ── Домен и SSL ──
DOMAIN=vpn.example.com
EMAIL=admin@example.com

# ── Секреты приложения ──
# Сгенерируйте: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-me-to-random-string-64-chars

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=yourbotname
WEBAPP_URL=https://vpn.example.com

# ── Доступ ──
# IP-адреса для доступа к /admin (через запятую)
ADMIN_IPS=127.0.0.1
# Telegram ID суперадмина (авто-создаётся при старте)
SUPERADMIN_TELEGRAM_ID=123456789
# Пароль для входа администратора (опционально, без Telegram)
ADMIN_PASSWORD=

# ── Каскадный VPN: серверы ──
# IP-адрес NL-сервера (Нидерланды — основной, весь не-RU трафик)
NL_SERVER_IP=
NL_SERVER_DOMAIN=
# IP-адрес RU-сервера (Россия — .ru/.su/.рф трафик)
RU_SERVER_IP=
RU_SERVER_DOMAIN=

# ── Xray ──
XRAY_CONFIG_PATH=/etc/xray/config.json
XRAY_CONTAINER_NAME=ufobzk-xray
VLESS_WS_PORT=443
REALITY_PORT=2053

# ── MTProto-прокси для Telegram (mtg) ──
# Публикуемый host-порт. Секрет НЕ хранится тут — генерируется в админке
# (Настройки → MTProto) и пишется в volume mtg-config.
MTPROTO_PORT=8765

# ── REALITY (NL-сервер) ──
# Сгенерируйте: bash scripts/05-setup-reality.sh
# DEST должен быть high-traffic сайтом (google/youtube/samsung/cloudflare)
# Чем выше реальный трафик на dest — тем сложнее DPI отличить REALITY handshake
REALITY_DEST=www.samsung.com:443
REALITY_SERVER_NAMES=www.samsung.com,samsung.com
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=

# ── Каскадный транзит NL → RU (серверный туннель) ──
# Заполните после настройки RU-сервера
RU_TRANSIT_UUID=
RU_TRANSIT_PORT=8443
RU_TRANSIT_PUBLIC_KEY=
RU_TRANSIT_SHORT_ID=aabbccdd
RU_TRANSIT_SN=www.google.com

# ── GEO-EXIT: своя нода как чистый выход (приоритетнее WARP) ──
# Гео-база Google метит IPv4 главного как RU. WARP это лечит не всегда:
# Cloudflare режет свои общие адреса для серверных диапазонов — handshake
# проходит, а трафик молча выбрасывается. Своя нода надёжнее.
#
# GEO_NODE_NAME — имя (name) строки в таблице servers, как в админке.
# Host, порт и ключи REALITY берутся из БД, дублировать их здесь не нужно.
# GEO_TRANSIT_UUID — любой случайный UUID; он автоматически добавляется в
# клиенты REALITY-инбаунда всех нод, поэтому выход можно переключать одним
# только GEO_NODE_NAME. Сгенерировать: python3 -c 'import uuid; print(uuid.uuid4())'
GEO_NODE_NAME=
GEO_TRANSIT_UUID=

# Список гео-чувствительных доменов (общий для GEO-EXIT и WARP).
# Старое имя WARP_DOMAINS ещё поддерживается.
GEO_DOMAINS=geosite:youtube,domain:googlevideo.com,domain:ytimg.com,domain:ggpht.com,domain:www.google.com,domain:gemini.google.com,domain:antigravity.google,domain:codeium.com,domain:cloudcode-pa.googleapis.com,domain:cloudaicompanion.googleapis.com,domain:generativelanguage.googleapis.com

# ── WARP (запасной выход, если своей ноды нет) ──
# Зачем: гео-база Google метит наш IPv4 как RU (поведенческий сигнал — через
# выход ходят почти только российские пользователи), хотя MaxMind/RIPE/Cloudflare
# видят NL. Правится только сменой выхода для google/youtube.
# Заполняется автоматически: bash scripts/06-setup-warp.sh
# WARP включается, только когда заданы PRIVATE_KEY + PUBLIC_KEY + ADDRESS_V4.
WARP_PRIVATE_KEY=
WARP_PUBLIC_KEY=
WARP_ADDRESS_V4=
WARP_ADDRESS_V6=
# Только IPv4-литерал: по AAAA-записи Xray падает с "network is unreachable",
# потому что в docker-сети backend нет IPv6
WARP_ENDPOINT=162.159.192.1:2408
# 3 байта client_id аккаунта WARP; скрипт вычисляет их сам
WARP_RESERVED=0,0,0
# Если трафик не идёт — пробуйте 1420
WARP_MTU=1280
# IPv6 внутри туннеля. НЕ включайте: контейнер xray в docker-сети без IPv6, и
# Xray уйдёт резолвить домены через 2606:4700:4700::1001 внутри туннеля —
# получите i/o timeout и молчаливо неработающий WARP.
WARP_IPV6=0
# Что заворачивать в WARP (синтаксис routing-правил Xray, через запятую).
# НЕ добавляйте "geosite:google" целиком: туда входят connectivitycheck.gstatic.com,
# dns.google, googleapis.com, mtalk.google.com (FCM). Если WARP отвалится, Android
# решит, что интернета нет, и приложения встанут при живом туннеле.
# Чем сервис пользуется на самом деле, видно в access.log:
#   bash scripts/16-warp-candidates.sh --watch 120
WARP_DOMAINS=geosite:youtube,domain:googlevideo.com,domain:ytimg.com,domain:ggpht.com,domain:www.google.com,domain:gemini.google.com,domain:antigravity.google,domain:codeium.com,domain:cloudcode-pa.googleapis.com,domain:cloudaicompanion.googleapis.com,domain:generativelanguage.googleapis.com
