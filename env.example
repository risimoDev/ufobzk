# ── Домен и SSL ──
DOMAIN=ufolabs.online
EMAIL=

# ── Секреты приложения ──
# ВНИМАНИЕ: репозиторий публичный. Реальные значения держите ТОЛЬКО в .env на сервере.
SECRET_KEY=

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ufo_comunitybot
WEBAPP_URL=https://ufolabs.online

# ── Каскадные серверы ──
NL_SERVER_IP=66.248.207.111
RU_SERVER_IP=193.163.203.40

# ── Xray ──
XRAY_CONFIG_PATH=/etc/xray/config.json
VLESS_WS_PORT=443
REALITY_PORT=2053

# ── MTProto-прокси для Telegram (mtg) ──
# Публикуемый host-порт. Секрет НЕ хранится тут — генерируется в админке
# (Настройки → MTProto) и пишется в volume mtg-config.
MTPROTO_PORT=8765

# ── REALITY (заполняется скриптом 05-setup-reality.sh) ──
REALITY_PUBLIC_KEY=
REALITY_PRIVATE_KEY=
REALITY_SHORT_ID=
REALITY_DEST=www.samsung.com:443
REALITY_SERVER_NAMES=www.samsung.com,samsung.com

# ── Доступ ──
# ADMIN_IPS — белый список IP для доступа к /admin (через запятую).
# Если не задан — доступ разрешён с любого IP (защита через пароль).
# ADMIN_IPS=85.17.162.53

SUPERADMIN_TELEGRAM_ID=
ADMIN_PASSWORD=
# ADMIN_USERNAME — логин для входа в /admin (пароль = ADMIN_PASSWORD выше).
# Если не задан, admin-пользователь не создаётся автоматически при деплое.
ADMIN_USERNAME=admin

# ── Xray ──
# Имя контейнера с xray (используется для перезапуска через docker socket).
XRAY_CONTAINER_NAME=ufobzk-xray

# ── Xray Node Token ──
# Токен для авторизации remote xray-node серверов (RU, доп. NL, Finland).
# Должен быть одинаковым на всех нодах. Сгенерируйте случайный 64 hex.
XRAY_NODE_TOKEN=

RU_TRANSIT_UUID=
RU_TRANSIT_PORT=443
RU_TRANSIT_PUBLIC_KEY=
RU_TRANSIT_SHORT_ID=aabbccdd
RU_TRANSIT_SN=www.yandex.ru

# ── GEO-V6: гео-домены через IPv6 главного сервера ──
# Требует IPv6 на хосте и enable_ipv6 у сети backend. Проверка: scripts/17-diagnose-geo.sh
# GEO_IPV6=auto — приложение само раз в 30 мин спрашивает Google о стране по IPv4
# и IPv6 и переключает выход на тот, что не RU (уведомление в Telegram суперадмину).
# GEO_AUTO_BAD_COUNTRIES=RU,BY — какие страны считать плохими.
GEO_IPV6=0

# ── GEO-EXIT: своя нода как чистый выход (приоритетнее IPv6 и WARP) ──
# GEO_NODE_NAME — имя строки в таблице servers (как в админке).
# GEO_TRANSIT_UUID — случайный UUID, попадает в клиенты REALITY всех нод.
GEO_NODE_NAME=
GEO_TRANSIT_UUID=

# ── WARP (запасной выход, если своей ноды нет) ──
# Гео-база Google метит наш IPv4 как RU, хотя MaxMind/RIPE/Cloudflare видят NL.
# Заполняется автоматически: bash scripts/06-setup-warp.sh
# Включается, только когда заданы PRIVATE_KEY + PUBLIC_KEY + ADDRESS_V4.
WARP_PRIVATE_KEY=
WARP_PUBLIC_KEY=
WARP_ADDRESS_V4=
WARP_ADDRESS_V6=
# Только IPv4-литерал — по AAAA Xray падает с "network is unreachable"
WARP_ENDPOINT=162.159.192.1:2408
WARP_RESERVED=0,0,0
WARP_MTU=1280
# IPv6 в туннеле — НЕ включать, в docker-сети backend нет IPv6
WARP_IPV6=0
# Доп. домены к встроенному списку Google (обычно не нужно)
GEO_DOMAINS=
